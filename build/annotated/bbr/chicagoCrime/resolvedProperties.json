{"defs":{},"properties":[{"path":["id"],"id":"http://purl.org/dc/terms/identifier","description":"Unique identifier for the record (CSV column \"ID\").","required":true,"schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["case_number"],"id":"https://platform.i-guide.io/def/chicago-crime/caseNumber","description":"Chicago Police Department Records Division number, unique to the incident (CSV column \"Case Number\").","required":true,"schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/caseNumber"},{"path":["date"],"id":"https://platform.i-guide.io/def/chicago-crime/date","jsonld_type":"http://www.w3.org/2001/XMLSchema#dateTime","description":"Date and local (America/Chicago) time when the incident occurred, sometimes a best estimate (CSV column \"Date\", converted from \"MM/DD/YYYY hh:mm:ss AM\" to ISO 8601 without offset).","required":true,"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/date"},{"path":["block"],"id":"https://platform.i-guide.io/def/chicago-crime/block","description":"Partially redacted address, placing the incident on the same block as the actual address (CSV column \"Block\").","schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/block"},{"path":["iucr"],"id":"https://platform.i-guide.io/def/chicago-crime/iucr","description":"Illinois Uniform Crime Reporting code (CSV column \"IUCR\").","required":true,"schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/iucr"},{"path":["primary_type"],"id":"https://platform.i-guide.io/def/chicago-crime/primaryType","description":"Primary description of the IUCR code (CSV column \"Primary Type\").","required":true,"schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/primaryType"},{"path":["description"],"id":"https://platform.i-guide.io/def/chicago-crime/description","description":"Secondary description of the IUCR code (CSV column \"Description\").","schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/description"},{"path":["location_description"],"id":"https://platform.i-guide.io/def/chicago-crime/locationDescription","description":"Description of the location where the incident occurred (CSV column \"Location Description\").","schema_type":["string","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/locationDescription"},{"path":["arrest"],"id":"https://platform.i-guide.io/def/chicago-crime/arrest","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","description":"Whether an arrest was made (CSV column \"Arrest\").","required":true,"schema_type":"boolean","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/arrest"},{"path":["domestic"],"id":"https://platform.i-guide.io/def/chicago-crime/domestic","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","description":"Whether the incident was domestic-related as defined by the Illinois Domestic Violence Act (CSV column \"Domestic\").","required":true,"schema_type":"boolean","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/domestic"},{"path":["beat"],"id":"https://platform.i-guide.io/def/chicago-crime/beat","description":"Police beat where the incident occurred; the smallest police geographic area (CSV column \"Beat\").","required":true,"schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/beat"},{"path":["district"],"id":"https://platform.i-guide.io/def/chicago-crime/district","description":"Police district where the incident occurred (CSV column \"District\").","schema_type":["string","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/district"},{"path":["ward"],"id":"https://platform.i-guide.io/def/chicago-crime/ward","jsonld_type":"http://www.w3.org/2001/XMLSchema#integer","description":"City Council district (ward) where the incident occurred (CSV column \"Ward\").","schema_type":["integer","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/ward"},{"path":["community_area"],"id":"https://platform.i-guide.io/def/chicago-crime/communityArea","jsonld_type":"http://www.w3.org/2001/XMLSchema#integer","description":"Community area where the incident occurred; Chicago has 77 community areas (CSV column \"Community Area\").","schema_type":["integer","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/communityArea"},{"path":["fbi_code"],"id":"https://platform.i-guide.io/def/chicago-crime/fbiCode","description":"Crime classification per the FBI National Incident-Based Reporting System (CSV column \"FBI Code\").","required":true,"schema_type":"string","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/fbiCode"},{"path":["x_coordinate"],"id":"https://platform.i-guide.io/def/chicago-crime/xCoordinate","jsonld_type":"http://www.w3.org/2001/XMLSchema#decimal","description":"X coordinate of the (shifted) incident location in State Plane Illinois East NAD 1983 projection, US feet (EPSG:3435) (CSV column \"X Coordinate\").","schema_type":["number","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/xCoordinate"},{"path":["y_coordinate"],"id":"https://platform.i-guide.io/def/chicago-crime/yCoordinate","jsonld_type":"http://www.w3.org/2001/XMLSchema#decimal","description":"Y coordinate of the (shifted) incident location in State Plane Illinois East NAD 1983 projection, US feet (EPSG:3435) (CSV column \"Y Coordinate\").","schema_type":["number","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/yCoordinate"},{"path":["year"],"id":"https://platform.i-guide.io/def/chicago-crime/year","jsonld_type":"http://www.w3.org/2001/XMLSchema#gYear","description":"Year the incident occurred (CSV column \"Year\").","required":true,"schema_type":"integer","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"https://platform.i-guide.io/def/chicago-crime/year"},{"path":["updated_on"],"id":"http://purl.org/dc/terms/modified","jsonld_type":"http://www.w3.org/2001/XMLSchema#dateTime","description":"Date and local time the record was last updated (CSV column \"Updated On\").","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"http://purl.org/dc/terms/modified"},{"path":["latitude"],"id":"http://www.w3.org/2003/01/geo/wgs84_pos#lat","jsonld_type":"http://www.w3.org/2001/XMLSchema#decimal","description":"WGS 84 latitude of the (shifted) incident location (CSV column \"Latitude\").","schema_type":["number","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"http://www.w3.org/2003/01/geo/wgs84_pos#lat"},{"path":["longitude"],"id":"http://www.w3.org/2003/01/geo/wgs84_pos#long","jsonld_type":"http://www.w3.org/2001/XMLSchema#decimal","description":"WGS 84 longitude of the (shifted) incident location (CSV column \"Longitude\").","schema_type":["number","null"],"sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"http://www.w3.org/2003/01/geo/wgs84_pos#long"},{"path":["location"],"id":"http://www.opengis.net/ont/geosparql#hasGeometry","jsonld_type":"@json","description":"Incident location as a GeoJSON Point (WGS 84 longitude, latitude). The CSV column \"Location\" carries the same point as WKT, e.g. \"POINT (-87.654831089 41.772324861)\".","sources":["bblocks://iguide.bbr.chicagoCrime"],"effectiveId":"http://www.opengis.net/ont/geosparql#hasGeometry"},{"path":["location","coordinates"],"required":true,"schema_type":"array","sources":["bblocks://iguide.bbr.chicagoCrime"]},{"path":["location","type"],"required":true,"const":"Point","sources":["bblocks://iguide.bbr.chicagoCrime"]}]}